{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "История",
  "version": "0.2.32",
  "identifier": "ru.istoriya.vncreator.rust",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 4173 --strictPort",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build && node scripts/prepare-native.mjs",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{"label":"main","title":"История","width":1440,"height":940,"minWidth":1000,"minHeight":700,"backgroundColor":"#11131a"}],
    "security": {"csp": null,"assetProtocol":{"enable":true,"scope":[]}}
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.ico"],
    "resources": {"../.artifacts/native-resources/":"native/"}
  }
}
