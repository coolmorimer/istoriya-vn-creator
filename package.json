{
  "name": "vn-creator",
  "version": "0.2.38",
  "description": "Визуальный конструктор новелл на Ren'Py без программирования",
  "author": "История",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 dev",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 build",
    "native:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 test",
    "native:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 check",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on http://127.0.0.1:4173 && cross-env ISTORIYA_DEV_URL=http://127.0.0.1:4173 electron .\"",
    "electron:start": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir --win",
    "desktop:package": "npm run build && electron-builder --win portable",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-installer.ps1",
    "installer:electron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "lint": "eslint src runtime electron worker",
    "build": "npm run lint && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "compile:demo": "node scripts/compile-demo.mjs",
    "verify:runtime": "node scripts/verify-advanced-runtime.mjs",
    "verify:release": "node scripts/verify-native-release-smoke.mjs",
    "verify:tea": "node scripts/test-tea-runtime.mjs --isolated-desktop --package release-games/tea-with-goblins/chay_vmesto_podviga-1.0.2-win.zip",
    "verify:tea:startup": "node scripts/test-tea-runtime.mjs --isolated-desktop --startup --package release-games/tea-with-goblins/chay_vmesto_podviga-1.0.2-win.zip",
    "verify:animations": "node scripts/verify-character-animation.mjs",
    "verify:backgrounds": "node scripts/verify-background-authoring.mjs",
    "verify:layers": "node scripts/verify-visual-order.mjs",
    "verify:keyframes": "node scripts/verify-keyframes.mjs",
    "verify:rpg": "node scripts/verify-rpg.mjs",
    "verify:rust-engine": "node scripts/verify-rust-engine.mjs",
    "verify:document": "node scripts/verify-document-parity.mjs",
    "verify:story": "node scripts/verify-story-parity.mjs",
    "verify:story:runtime": "node scripts/verify-story-runtime.mjs",
    "verify:props": "node scripts/verify-prop-interactions.mjs",
    "verify:logic": "node scripts/verify-game-logic.mjs",
    "build:demo:win": "node scripts/build-demo-win.mjs",
    "build:demo:target": "node scripts/build-demo-target.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.3",
    "@vitejs/plugin-react": "5.0.4",
    "immer": "11.1.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "ru.istoriya.vncreator",
    "productName": "История",
    "asar": true,
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "runtime/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "../renpy-8.5.3-sdk",
        "to": "renpy-sdk",
        "filter": [
          "**/*",
          "!tmp/**",
          "!rapt/project/**",
          "!rapt/sdk.txt",
          "!**/saves/**",
          "!**/*.log",
          "!**/log.txt",
          "!**/traceback.txt",
          "!**/errors.txt",
          "!**/*.keystore",
          "!**/*.jks",
          "!**/local.properties",
          "!**/.DS_Store"
        ]
      },
      {
        "from": ".artifacts/notices",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Istoriya-${version}-${arch}.${ext}"
    }
  }
}
